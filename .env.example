# CLIMATESHIELD AI — Environment Variables Configuration

# General
VITE_APP_NAME="ClimateShield AI"
VITE_APP_ENV="development"
VITE_APP_VERSION="1.0.0"

# AI Engine / Copilot — Step 10 architecture
# The assistant defaults to the built-in local context engine (no keys needed).
# To connect a real LLM, point VITE_ASSISTANT_API_URL at YOUR OWN backend proxy
# that holds the LLM key server-side. NEVER put an LLM API key in this frontend
# repo or in a VITE_ variable — anything prefixed VITE_ is bundled into the
# public JS and readable by every visitor.
VITE_ASSISTANT_API_URL=""

# Deprecated placeholders from earlier scaffolding — do NOT put real keys here.
VITE_OPENAI_API_KEY=""
VITE_GEMINI_API_KEY=""

# Map Services (Optional live token - fallback to CartoDB dark tiles)
VITE_MAPBOX_ACCESS_TOKEN=""

# Environmental & Weather Feeds (Optional external APIs)
VITE_OPENWEATHER_API_KEY=""
VITE_AIRVISUAL_API_KEY=""
VITE_OPENAQ_API_KEY=""

# Backend & Database Architecture
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
